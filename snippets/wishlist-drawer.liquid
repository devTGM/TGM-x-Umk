<div id="wishlist-drawer" class="wishlist-drawer color-{{ settings.color_scheme_for_drawers | default: 'background-1' }}" aria-modal="true" role="dialog" style="position: fixed; top: 0; right: 0; width: 420px; max-width: 90vw; height: 100vh; background: #ffffff !important; z-index: 9999; transform: translateX(100%); transition: transform 0.3s ease; box-shadow: -5px 0 30px rgba(0,0,0,0.1); display: flex; flex-direction: column;">
  <div class="wishlist-drawer__header" style="padding: 2.5rem 2.5rem 1.5rem; display: flex; justify-content: space-between; align-items: center;">
    <h2 class="h3" style="margin: 0; font-size: 2.4rem; font-weight: 500; text-transform: uppercase; display: flex; align-items: flex-start; letter-spacing: 0.5px;">Your Wishlist<sup class="wishlist-count-badge" style="font-size: 1.4rem; color: #888; font-weight: 400; margin-left: 4px; display: none;">0</sup></h2>
    <button type="button" class="wishlist-drawer__close" style="background: none; border: none; cursor: pointer; padding: 0; display: flex; color: #111;" aria-label="Close wishlist">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
    </button>
  </div>
  <div class="wishlist-drawer__body" style="padding: 2rem; overflow-y: auto; flex: 1;">
    <div class="wishlist-empty" style="display: none; padding: 12rem 0; text-align: center;">
      <div style="font-size: 5rem; line-height: 0.9; margin-bottom: 2.5rem; text-transform: uppercase; font-weight: 500; letter-spacing: -1px; text-align: center; color: #111;">
        <span style="display: block;">IT'S A LITTLE</span>
        <span style="display: block;"><i style="font-style: italic; padding-right: 4px;">EMPTY</i> HERE</span>
      </div>
      <p style="margin-bottom: 3.5rem; text-transform: uppercase; font-size: 1.1rem; color: #555; letter-spacing: 0.5px;">Your wishlist is currently empty</p>
      <button class="wishlist-drawer__close" style="background: #ffffff; color: #111; border: 1px solid #111; border-radius: 30px; padding: 1rem 2.5rem; font-size: 1rem; text-transform: uppercase; font-weight: 500; letter-spacing: 1px; cursor: pointer; transition: all 0.3s ease;" onmouseover="this.style.background='#111'; this.style.color='#ffffff';" onmouseout="this.style.background='#ffffff'; this.style.color='#111';">Start Shopping</button>
    </div>
    <div class="wishlist-drawer-grid" style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.5rem;">
      <!-- Wishlist items will be injected here -->
    </div>
  </div>
</div>
<div id="wishlist-drawer-overlay" style="position: fixed; inset: 0; background: rgba(0,0,0,0.5); z-index: 9998; opacity: 0; pointer-events: none; transition: opacity 0.3s ease;"></div>
