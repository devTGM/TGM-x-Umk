<header-drawer class="drawer drawer--start header__drawer{% unless section.settings.layout == 'header--nav-drawer' %} mobile-drawer large-up-hide{% endunless %}">
  <details id="Navigation-drawer-{{- append_id -}}" class="drawer__container">
    <summary
      class="drawer__button"
      id="Navigation-drawer-button-{{- append_id -}}"
      aria-label="{{- 'theme.actions.open_menu' | t -}}"
    >
      {%- render 'icon', icon_name: 'theme-menu' -%}
      {%- render 'icon', icon_name: 'theme-close-small' -%}

      <noscript>
        {%- render 'icon', icon_name: 'theme-arrow' -%}
      </noscript>
    </summary>

    <div class="drawer__content drawer__content--nav js-drawer color-{{ section.settings.color_scheme_for_drawer }} gradient" id="Navigation-menu-drawer-{{- append_id -}}" tabindex="-1">
      <button
        class="drawer__button-close header-drawer__button-close button-reset small-hide medium-hide no-js-hidden js-btn-close-drawer"
        aria-label="{{- 'theme.actions.close' | t -}}"
      >
        {%- render 'icon', icon_name: 'theme-arrow' -%}
      </button>

      <nav class="slide-out-menu">
        <div class="menu-panels">
          <div class="primary-menu-panel">
            <ul>
              {% for link in menu.links %}
                {% liquid
                  assign link_item_index = forloop.index
                  assign link_handle = link.title | handleize
                  assign count_of_cards = 0
                  assign count_of_items = 0

                  for block in section.blocks

                    if link_item_index != block.settings.menu_item_position
                      continue
                    endif

                    if block.settings.title != blank or block.settings.subtitle != blank or block.settings.image != blank
                      assign count_of_cards = count_of_cards | plus: 1
                    endif
                  endfor

                  assign count_of_items = count_of_items | plus: link.links.size | plus: count_of_cards
                %}
                <li>
                  {%- if count_of_items > 0 -%}
                    <button type="button" class="menu-link h4" data-ref="{{ link_handle }}">
                      {{ link.title }}
                      {% render 'icon', icon_name: 'theme-chevron', class: 'icon' %}
                    </button>
                  {%- else -%}
                    <a href="{{ link.url }}" class="h4" {% if link.current %}aria-current="page"{% endif %}>
                      {{ link.title | escape }}
                    </a>
                  {%- endif -%}
                </li>
              {% endfor %}
            </ul>
          </div>
          {% for link in menu.links %}
            {% liquid
              assign link_item_index = forloop.index
              assign link_handle = link.title | handleize
              assign count_of_cards = 0
              assign count_of_items = 0

              for block in section.blocks
                if link_item_index != block.settings.menu_item_position
                  continue
                endif

                if block.settings.title != blank or block.settings.subtitle != blank or block.settings.image != blank
                  assign count_of_cards = count_of_cards | plus: 1
                endif
              endfor

              assign count_of_items = count_of_items | plus: link.links.size | plus: count_of_cards
            %}
            {% if count_of_items == 0 %}
              {% continue %}
            {% endif %}
            <div class="menu-panel" data-menu="{{ link_handle }}">
              <button type="button" class="menu-link menu-header">
                {% render 'icon', icon_name: 'theme-chevron', class: 'icon icon--rotate-180' %}
                {{ link.title }}
              </button>
              <ul>
                {% for child_link in link.links %}
                  <li class="menu-link-group">
                    {%- if child_link.links.size > 0 -%}
                      <button type="button" class="menu-link h4" data-ref="{{ link_handle | append: '-' | append: child_link.title | handle }}">
                        {{ child_link.title }}
                        {% render 'icon', icon_name: 'theme-chevron', class: 'icon' %}
                      </button>
                    {%- else -%}
                      <a href="{{ child_link.url }}" class="h4" {% if child_link.current %}aria-current="page"{% endif %}>
                        {{ child_link.title | escape }}
                      </a>
                    {%- endif -%}
                  </li>
                {% endfor %}

                {% if count_of_cards > 0 %}
                  {%- style -%}
                    .menu-card-group {
                      --header-nav-group-card-gap: calc(var(--spacing-unit-size) * {{ section.settings.spacing_between_cards }});
                    }
                  {%- endstyle -%}
                  <li class="menu-card-group">
                    {%- assign link_item_index = forloop.index -%}

                    {%- style -%}
                      {%- for block in section.blocks -%}
                        {%- assign card_aspect_ratio = section.settings.card_aspect_ratio -%}
                        {% if block.settings.card_aspect_ratio != 'same_as_section' %}
                          {%- assign card_aspect_ratio = block.settings.card_aspect_ratio -%}
                        {% endif %}
                        .block-{{ block.id }} {
                          --header-nav-group-card-aspect-ratio: {{ section.settings.card_aspect_ratio_mobile }};
                        }
                        @media screen and (min-width: 750px) {
                          .block-{{ block.id }} {
                            --header-nav-group-card-aspect-ratio: {{ card_aspect_ratio }};
                          }
                        }
                      {%- endfor -%}
                    {%- endstyle -%}

                    {% for block in section.blocks %}
                      {%- liquid
                        assign link_handle = link.title | handleize
                        assign show_on_class = block.settings.show_on
                        if show_on_class == 'mobile'
                          assign show_on_class = 'large-up-hide'
                        elsif show_on_class == 'desktop'
                          assign show_on_class = 'small-hide medium-hide'
                        else
                          assign show_on_class = ''
                        endif
                      -%}
                      {%- if link_item_index == block.settings.menu_item_position -%}
                        <div class="card header__card header__card-text color-{{ block.settings.color_scheme }} block-{{ block.id }} {{ show_on_class }} media-position--background">
                          {%- if block.settings.image != blank -%}
                            <div class="media media--overlay card__media media--{{ block.settings.card_aspect_ratio }}">
                              {%- render 'image', image: block.settings.image, alt: block.settings.image.alt | escape -%}
                            </div>
                          {%- endif -%}

                          {%- if block.settings.title != blank or block.settings.subtitle != blank -%}
                            <div class="content {{ block.settings.content_position_horizontal }} {{ block.settings.content_position_vertical }}">
                              {%- if block.settings.subtitle != blank -%}
                                <span class="card__subtitle">
                                  {{- block.settings.subtitle -}}
                                </span>
                              {%- endif -%}

                              {%- if block.settings.title != blank -%}
                                <h6 class="card__title h4">
                                  {{- block.settings.title -}}
                                </h6>
                              {%- endif -%}
                            </div>
                          {%- endif -%}
                          {%- if block.settings.link -%}
                            <a href="{{- block.settings.link -}}" class="card__link">
                              <span class="visually-hidden">{{- block.settings.title -}}</span>
                            </a>
                          {%- endif -%}
                        </div>
                      {%- endif -%}
                    {% endfor %}
                  </li>
                {% endif %}


              </ul>
            </div>
            {% for child_link in link.links %}
              {% if child_link.links.size == 0 %}
                {% continue %}
              {% endif %}
              <div class="menu-panel" data-menu="{{ link_handle | append: '-' | append: child_link.title | handle }}" data-menu-nested>
                <button type="button" class="menu-link menu-header" data-ref="{{ link_handle }}">
                  {% render 'icon', icon_name: 'theme-chevron', class: 'icon icon--rotate-180' %}
                  {{ child_link.title }}
                </button>
                <ul>
                  {% for grand_child_link in child_link.links %}
                    <li>
                      <a href="{{ grand_child_link.url }}" class="h4" {% if grand_child_link.current %}aria-current="page"{% endif %}>
                        {{ grand_child_link.title | escape }}
                      </a>
                    </li>
                  {% endfor %}
                </ul>
              </div>
            {% endfor %}
          {% endfor %}
        </div>
      </nav>

      {%- if submenu != blank -%}
        <div class="drawer__row">
          <nav class="drawer__subnav">
            <ul class="list-unstyled">
              {%- for link in submenu.links -%}
                <li class="drawer__subnav-item">
                  <a
                    href="{{- link.url -}}"
                    class="drawer__subnav-link h6{% if link.current %} is-current{% endif %}"
                    {% if link.current %}aria-current="page"{% endif %}
                  >
                    {{- link.title | escape -}}
                  </a>
                </li>
              {%- endfor -%}
            </ul>
          </nav>
        </div>
      {%- endif -%}

      <div class="drawer__row drawer__row--bottom">
        <nav class="drawer__subs">
          <ul class="drawer__subs-items list-unstyled">
            <li class="drawer__subs-item">
              <a
                href="{%- if customer -%}{{ routes.account_url }}{%- else -%}{{ routes.account_login_url }}{%- endif -%}"
                class="drawer__subs-link"
                title="{%- if customer -%}{{ 'customer.account.label' | t }}{%- else -%}{{ 'theme.actions.log_in' | t }}{%- endif -%}"
              >
                {{- 'customer.account.label' | t -}}
              </a>
            </li>
            {%- if section.settings.country_drawer_navigation_menu -%}
              <li class="drawer__subs-item">
                <menu-drawer class="drawer">
                  {%- render 'country-drawer',
                    button_class: ' drawer__subs-link',
                    section: section,
                    append_id: 'header-drawer-' | append: section.id
                  -%}
                </menu-drawer>
              </li>
            {%- endif -%}
          </ul>
        </nav>
        <div class="drawer__social">
          <ul class="drawer__social-list list-unstyled">
            {% render 'social-media', item_tag: 'li', in_new_tab: true, item_icon: true %}
          </ul>
        </div>
      </div>
    </div>
  </details>
</header-drawer>

<style>
  /* ============================================================
     MOBILE NAVIGATION DRAWER SMOOTH SCROLL FIX
     ============================================================ */
  @media screen and (max-width: 989px) {
    /* Set drawer content to span full visible viewport height below header with touch momentum scrolling */
    html.js .header__drawer > .drawer__container.menu-opening > .drawer__content,
    html.js .header__drawer > .drawer__container[open] > .drawer__content,
    .drawer__content.drawer__content--nav {
      position: fixed !important;
      inset-block-start: calc(var(--header-height, 5.6rem) + var(--announcement-bars-before-header-visible-heights, 0px)) !important;
      inset-inline-start: 0 !important;
      inset-inline-end: 0 !important;
      width: 100vw !important;
      max-width: 100vw !important;
      height: calc(100dvh - var(--header-height, 5.6rem) - var(--announcement-bars-before-header-visible-heights, 0px)) !important;
      max-height: calc(100dvh - var(--header-height, 5.6rem) - var(--announcement-bars-before-header-visible-heights, 0px)) !important;
      overflow-y: auto !important;
      overflow-x: hidden !important;
      -webkit-overflow-scrolling: touch !important;
      overscroll-behavior-y: contain !important;
      touch-action: pan-y !important;
      display: flex !important;
      flex-direction: column !important;
      padding: 1.6rem var(--page-gutter, 2rem) calc(6rem + env(safe-area-inset-bottom, 20px)) !important;
      box-sizing: border-box !important;
      background-color: rgb(var(--color-background, 255, 255, 255)) !important;
      z-index: var(--z-modals, 999) !important;
    }

    /* Prevent slide out menu from trapping or clipping scroll */
    .drawer__content--nav nav.slide-out-menu {
      width: 100% !important;
      flex-shrink: 0 !important;
      position: relative !important;
      transform: none !important;
      touch-action: pan-y !important;
    }

    .drawer__content--nav nav.slide-out-menu div.menu-panels {
      position: relative !important;
      width: 100% !important;
      height: auto !important;
    }

    /* Primary menu panel */
    .drawer__content--nav .primary-menu-panel {
      width: 100% !important;
      flex-shrink: 0 !important;
      transition: opacity 0.25s ease;
    }

    /* When submenu is active, hide primary panel so drawer height conforms to active submenu */
    .drawer__content--nav nav.slide-out-menu:has(.menu-panel.is-active) .primary-menu-panel {
      display: none !important;
    }

    /* Active submenu panel */
    .drawer__content--nav nav.slide-out-menu div.menu-panel.is-active {
      position: relative !important;
      transform: none !important;
      opacity: 1 !important;
      visibility: visible !important;
      pointer-events: auto !important;
      width: 100% !important;
      height: auto !important;
      max-height: none !important;
      overflow: visible !important;
      padding: 0.4rem 0 2.4rem !important;
      background: transparent !important;
      touch-action: pan-y !important;
    }

    /* Inactive submenu panels hidden */
    .drawer__content--nav nav.slide-out-menu div.menu-panel:not(.is-active) {
      display: none !important;
    }

    /* Menu links and touch targets */
    .drawer__content--nav nav.slide-out-menu div.menu-panels button.menu-link,
    .drawer__content--nav nav.slide-out-menu div.menu-panels ul li a {
      display: flex !important;
      align-items: center !important;
      justify-content: space-between !important;
      padding: 1.6rem 0 !important;
      width: 100% !important;
      touch-action: manipulation !important;
      color: rgb(var(--color-foreground)) !important;
      font-size: 1.8rem !important;
    }

    .drawer__content--nav nav.slide-out-menu div.menu-panels button.menu-header {
      padding: 1.2rem 0 1.6rem 0 !important;
      margin-bottom: 0.8rem !important;
      border-bottom: 0.1rem solid rgba(var(--color-foreground), 0.1) !important;
      font-size: 1.5rem !important;
      font-weight: 600 !important;
      display: flex !important;
      align-items: center !important;
      gap: 0.8rem !important;
      color: rgb(var(--color-foreground)) !important;
    }

    /* Submenu card groups */
    .drawer__content--nav nav.slide-out-menu li.menu-card-group {
      display: flex !important;
      flex-flow: row wrap !important;
      gap: 1.2rem !important;
      margin-top: 2rem !important;
      width: 100% !important;
    }

    .drawer__content--nav nav.slide-out-menu li.menu-card-group .card {
      width: 100% !important;
      min-height: 140px !important;
      aspect-ratio: auto !important;
    }

    /* Subnav and bottom drawer rows */
    .drawer__content--nav .drawer__row {
      width: 100% !important;
      flex-shrink: 0 !important;
    }

    .drawer__content--nav .drawer__row--bottom {
      margin-top: 2.4rem !important;
      padding-top: 1.6rem !important;
      border-top: 0.1rem solid rgba(var(--color-foreground), 0.1) !important;
      flex-shrink: 0 !important;
    }

    .drawer__content--nav .drawer__subs-items {
      display: flex !important;
      flex-direction: column !important;
      align-items: flex-start !important;
      gap: 1.2rem !important;
    }

    .drawer__content--nav .drawer__social {
      margin-top: 1.6rem !important;
    }
  }
</style>
