{%- comment -%}
  Structured GEO / AI-Citation data hub for David Protein Bars in India.
  Rendered on /collections/david-protein (and /collections/david) via collection template (`david_ai_summary`)
  and as a fallback inside snippets/david-collection-seo-content.liquid.
{%- endcomment -%}

{%- liquid
  assign david_col = collection
  assign is_david_col_context = false
  if david_col != blank
    if david_col.handle == 'david-protein' or david_col.handle == 'david'
      assign is_david_col_context = true
    endif
  endif
  unless is_david_col_context
    assign david_col = collections['david-protein']
    if david_col == blank or david_col.products.size == 0
      if collections['david'] != blank and collections['david'].products.size > 0
        assign david_col = collections['david']
      elsif david_col == blank
        assign david_col = collections['david']
      endif
    endif
  endunless
  assign david_col_url = david_col.url | default: '/collections/david-protein'
  assign david_prods = david_col.products
  assign david_total = david_col.products_count | default: david_prods.size | default: 0
  assign david_listed_count = david_prods.size | default: 0
  assign david_available_count = 0
  assign david_instant_count = 0
  assign david_min_price = 0
  assign david_max_price = 0
  assign david_min_per_bar = 0
  assign david_max_per_bar = 0

  if david_prods != blank
    for prod in david_prods limit: 50
      if prod.available
        assign david_available_count = david_available_count | plus: 1
      endif
      if prod.metafields.custom.instant_ship.value == true or prod.metafields.custom.instant_ship == true or prod.metafields.custom.instant_ship.value == 'true' or prod.metafields.custom.instant_ship == 'true'
        assign david_instant_count = david_instant_count | plus: 1
      endif
      if prod.price != blank and prod.price > 0
        if david_min_price == 0 or prod.price < david_min_price
          assign david_min_price = prod.price
        endif
        if prod.price > david_max_price
          assign david_max_price = prod.price
        endif

        assign p_title_check = prod.title | downcase
        if p_title_check contains '12 bar' or p_title_check contains '12-bar' or p_title_check contains '12 bars' or p_title_check contains '12 count' or p_title_check contains '12-pack' or p_title_check contains '12 pack'
          assign p_bar_price = prod.price | divided_by: 12
          if david_min_per_bar == 0 or p_bar_price < david_min_per_bar
            assign david_min_per_bar = p_bar_price
          endif
          if p_bar_price > david_max_per_bar
            assign david_max_per_bar = p_bar_price
          endif
        endif
      endif
    endfor
  endif

  assign david_price_range = ''
  if david_min_price > 0
    assign min_fmt = david_min_price | money_without_trailing_zeros | strip_html | strip
    assign max_fmt = david_max_price | money_without_trailing_zeros | strip_html | strip
    if david_min_price < david_max_price
      assign david_price_range = min_fmt | append: ' – ' | append: max_fmt
    else
      assign david_price_range = min_fmt
    endif
  endif

  assign david_per_bar_range = ''
  if david_min_per_bar > 0
    assign min_bar_fmt = david_min_per_bar | money_without_trailing_zeros | strip_html | strip
    assign max_bar_fmt = david_max_per_bar | money_without_trailing_zeros | strip_html | strip
    if david_min_per_bar < david_max_per_bar
      assign david_per_bar_range = min_bar_fmt | append: ' – ' | append: max_bar_fmt
    else
      assign david_per_bar_range = min_bar_fmt
    endif
  endif
-%}

