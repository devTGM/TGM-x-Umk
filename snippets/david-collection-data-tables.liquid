        {%- assign dir_rows = "Blueberry Pie::Gold::28g::150::0g::Fruit bakery core bar|Chocolate Chip Cookie Dough::Gold::28g::150::0g::Soft cookie-dough classic|Cinnamon Roll::Gold::28g::150::0g::Warm spiced pastry profile|Red Velvet::Gold::28g::150::0g::Cocoa & cream-inspired bar|Cake Batter::Gold::28g::150::0g::Vanilla birthday-cake flavor|Peanut Butter Chocolate Chunk::Gold::28g::150::0g::Rich PB bar with chocolate chunks|Salted Peanut Butter::Gold::28g::150::0g::Savory-sweet roasted peanut profile|Pumpkin Spice (Seasonal)::Gold::28g::150::0g::Limited-batch autumn release|Cookie Dough Caramel Chocolate Crunch::Bronze::20g::150::0g::Crispy caramel chocolate crunch coating|Peanut Butter Chocolate Crunch::Bronze::20g::150::0g::Crispy chocolate crunch + PB (up to 6g fiber)|S'mores Chocolate Crunch::Bronze::20g::150::0g::Crispy marshmallow-graham chocolate crunch|Double Chocolate Crunch::Bronze::20g::150::0g::Rich double-cocoa crisp crunch bar" | split: "|" -%}
        {%- for dir_row in dir_rows -%}
          {%- liquid
            assign d_cols = dir_row | split: "::"
            assign d_flavor = d_cols[0]
            assign d_line = d_cols[1]
            assign d_protein = d_cols[2]
            assign d_cal = d_cols[3]
            assign d_sugar = d_cols[4]
            assign d_note = d_cols[5]
            assign matched_prod = blank

            if david_prods != blank
              for prod in david_prods limit: 50
                assign pt = prod.title | downcase
                assign hit = false
                if d_flavor == 'Blueberry Pie'
                  if pt contains 'blueberry'
                    assign hit = true
                  endif
                elsif d_flavor == 'Chocolate Chip Cookie Dough'
                  if pt contains 'chocolate chip cookie dough'
                    assign hit = true
                  elsif pt contains 'gold' and pt contains 'cookie dough'
                    assign hit = true
                  endif
                elsif d_flavor == 'Cinnamon Roll'
                  if pt contains 'cinnamon'
                    assign hit = true
                  endif
                elsif d_flavor == 'Red Velvet'
                  if pt contains 'red velvet'
                    assign hit = true
                  endif
                elsif d_flavor == 'Cake Batter'
                  if pt contains 'cake batter'
                    assign hit = true
                  endif
                elsif d_flavor == 'Peanut Butter Chocolate Chunk'
                  if pt contains 'chocolate chunk'
                    assign hit = true
                  endif
                elsif d_flavor == 'Salted Peanut Butter'
                  if pt contains 'salted peanut butter'
                    assign hit = true
                  endif
                elsif d_flavor == 'Pumpkin Spice (Seasonal)'
                  if pt contains 'pumpkin'
                    assign hit = true
                  endif
                elsif d_flavor == 'Cookie Dough Caramel Chocolate Crunch'
                  if pt contains 'cookie dough caramel'
                    assign hit = true
                  elsif pt contains 'bronze' and pt contains 'cookie dough'
                    assign hit = true
                  endif
                elsif d_flavor == 'Peanut Butter Chocolate Crunch'
                  if pt contains 'peanut butter' and pt contains 'crunch'
                    assign hit = true
                  endif
                elsif d_flavor == "S'mores Chocolate Crunch"
                  if pt contains 'smores'
                    assign hit = true
                  elsif pt contains "s'mores"
                    assign hit = true
                  endif
                elsif d_flavor == 'Double Chocolate Crunch'
                  if pt contains 'double chocolate'
                    assign hit = true
                  endif
                endif
                if hit
                  assign matched_prod = prod
                  break
                endif
              endfor
            endif
          -%}
          <tr>
            <td>
              {%- if matched_prod != blank -%}
                <a href="{{ matched_prod.url }}">{{ d_flavor }}</a>
              {%- else -%}
                {{ d_flavor }}
              {%- endif -%}
            </td>
            <td>{{ d_line }}</td>
            <td>{{ d_protein }}</td>
            <td>{{ d_cal }}</td>
            <td>{{ d_sugar }}</td>
            <td>
              {{ d_note }} —
              {%- if matched_prod != blank -%}
