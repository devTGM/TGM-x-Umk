<input type="hidden" value="true" id="srCheckoutAutoOnboardClient"/>
<link rel="preload" as="style" href="https://fastrr-boost-ui.pickrr.com/assets/styles/sr-checkout.css">
<link rel="stylesheet" href="https://fastrr-boost-ui.pickrr.com/assets/styles/sr-checkout.css">
<noscript>
  <link rel="stylesheet" href="https://fastrr-boost-ui.pickrr.com/assets/styles/sr-checkout.css">
</noscript>
<script src="https://fastrr-boost-ui.pickrr.com/assets/js/channels/shopify.js" defer></script>
<script src="https://fastrr-boost-ui.pickrr.com/assets/js/channels/shiprocketMarketing.js" defer></script>

<script>
  (function() {
    window.initFastrr = window.initFastrr || function() {};
    var isInitiating = false;

    function getCheckoutHandler() {
      if (window.shiprocketCheckoutEvents && typeof window.shiprocketCheckoutEvents.buyCart === 'function') {
        return function(e) {
          window.shiprocketCheckoutEvents.buyCart(e);
        };
      }
      if (typeof window.shiprocketCheckoutBuyCartHandler === 'function') {
        return function(e) {
          window.shiprocketCheckoutBuyCartHandler(e);
        };
      }
      if (window.HeadlessCheckout && typeof window.HeadlessCheckout.checkout === 'function') {
        return function(e) {
          window.HeadlessCheckout.checkout(e);
        };
      }
      // Strictly scoped fallback only to cart/mini-cart headless buttons (never product page buy-now buttons)
      var nativeCartBtn = document.querySelector('.shiprocket-headless[data-type="mini-cart"] button, .shiprocket-headless[data-type="cart"] button, cart-drawer .shiprocket-headless button');
      if (nativeCartBtn && typeof nativeCartBtn.click === 'function') {
        return function() {
          nativeCartBtn.click();
        };
      }
      return null;
    }

    function handleSrCheckout(e) {
      if (e) {
        if (typeof e.preventDefault === 'function') e.preventDefault();
        if (typeof e.stopPropagation === 'function') e.stopPropagation();
      }

      if (isInitiating) return;
      isInitiating = true;
      setTimeout(function() { isInitiating = false; }, 3000);

      // Validate Terms & Conditions if present
      const termsCheckbox = document.getElementById('Terms-Conditions');
      if (termsCheckbox && !termsCheckbox.checked) {
        isInitiating = false;
        termsCheckbox.focus();
        if (typeof termsCheckbox.reportValidity === 'function') {
          termsCheckbox.reportValidity();
        }
        return;
      }

      // Safely resolve the button element without ever selecting `document`
      var btn = null;
      if (e && e.target && typeof e.target.closest === 'function') {
        btn = e.target.closest('.custom-checkout-btn, button[name="checkout"], .cart__summary-button, [data-checkout-button]');
      }
      if (!btn && e && e.currentTarget && typeof e.currentTarget.closest === 'function') {
        btn = e.currentTarget.closest('.custom-checkout-btn, button[name="checkout"], .cart__summary-button, [data-checkout-button]');
      }
      if (!btn) {
        btn = document.querySelector('.custom-checkout-btn, button[name="checkout"], .cart__summary-button, [data-checkout-button]');
      }

      function restoreBtn() {
        if (btn && btn.classList && typeof btn.classList.remove === 'function') {
          btn.classList.remove('is-loading');
          btn.style.opacity = '';
          btn.style.pointerEvents = '';
        }
      }

      if (btn && btn.classList && typeof btn.classList.add === 'function') {
        btn.classList.add('is-loading');
        btn.style.opacity = '0.7';
        btn.style.pointerEvents = 'none';
      }

      function executeCheckout() {
        const handler = getCheckoutHandler();
        if (handler) {
          try {
            handler(e);
            setTimeout(restoreBtn, 2500);
            return;
          } catch(err) {
            console.error('[Sr-checkout] Error invoking handler:', err);
          }
        }

        // If script is still loading in background, wait and retry up to 10 seconds
        let attempts = 0;
        const interval = setInterval(function() {
          attempts++;
          const h = getCheckoutHandler();
          if (h) {
            clearInterval(interval);
            try {
              h(e);
              setTimeout(restoreBtn, 2500);
            } catch(err) {
              console.error('[Sr-checkout] Async invocation error:', err);
              restoreBtn();
            }
          } else if (attempts >= 100) {
            clearInterval(interval);
            restoreBtn();
            console.warn('[Sr-checkout] Timeout waiting for Shiprocket checkout script');
          }
        }, 100);
      }

      // If cart drawer is currently updating line items (e.g. quantity change), wait briefly for it to settle
      var isCartBusy = document.querySelector('cart-drawer-items.is-loading, .cart-drawer-items.is-loading, cart-items.is-loading, .cart-items.is-loading');
      if (isCartBusy) {
        setTimeout(executeCheckout, 300);
      } else {
        executeCheckout();
      }
    }
    window.handleSrCheckout = handleSrCheckout;

    // Intercept checkout clicks in cart drawer and cart page
    document.addEventListener('click', function(e) {
      const target = e.target;
      if (!target || typeof target.closest !== 'function') return;
      const btn = target.closest('.custom-checkout-btn, [data-checkout-button]');
      if (btn) {
        handleSrCheckout(e);
        return;
      }
      const checkoutNameBtn = target.closest('button[name="checkout"], .cart__summary-button');
      if (checkoutNameBtn && checkoutNameBtn.closest('cart-drawer, .cart-drawer, #CartDrawer-FormSummary, #cart-summary, .cart__summary, .cart-drawer__action-buttons, .cart__actions')) {
        handleSrCheckout(e);
      }
    }, true);

    // Intercept submit on cart drawer and cart page forms to ensure they route to Shiprocket checkout
    document.addEventListener('submit', function(e) {
      const form = e.target;
      if (form && (form.id === 'CartDrawer-FormSummary' || form.id === 'cart' || (form.classList && (form.classList.contains('cart-drawer__form-summary') || form.classList.contains('cart__contents'))))) {
        if (typeof e.preventDefault === 'function') e.preventDefault();
        handleSrCheckout(e);
        return false;
      }
    }, true);
  })();
</script>

