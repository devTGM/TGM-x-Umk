{%- comment -%}
  Renders cart drawer

  Usage:
  {%- render 'cart-drawer' -%}
{%- endcomment -%}

{{- 'component-cart-drawer.aio.min.css' | asset_url | stylesheet_tag -}}
{{- 'component-cart.aio.min.css' | asset_url | stylesheet_tag -}}
{{- 'custom-cart.css' | asset_url | stylesheet_tag -}}

{% if template.name != 'cart' %}
  <script src="{{- 'cart.js' | asset_url -}}" defer="defer"></script>
{% endif %}
<script src="{{- 'cart-info-bar-slider.js' | asset_url -}}" defer="defer"></script>

<style>
  /* Forcibly hide the duplicated price element on the right side of the cart drawer */
  .cart-drawer .cart-item__actions--price {
    display: none !important;
  }
</style>

{%- style -%}
  cart-drawer .cart-item .media {
    aspect-ratio: {{ section.settings.card_media_aspect_ratio }};
  }
{%- endstyle -%}

<cart-drawer>
  <div class="color-{{ settings.color_scheme_for_drawers }} gradient">
    <div class="cart-drawer" id="{{- section.id -}}">

      <div class="cart-drawer__inner"
        role="dialog"
        aria-modal="true"
        aria-label="{{- 'cart.title' | t -}}"
        tabindex="-1"
      >
        {%- if section.blocks.size > 0 -%}
        <cart-drawer-info-slider class="cart-drawer__information-bar">
          <div class="swiper cart-drawer__swiper">
            <div class="swiper-wrapper">
              {%- for block in section.blocks -%}
                {% if block.settings.title != blank %}
                <div class="swiper-slide">
                  <div class="cart-drawer__information-bar-content">
                    {%- if block.settings.icon != blank or block.settings.custom_icon != blank -%}
                      <div class="cart-drawer__info-icon icon">
                      {% liquid
                        assign icon_alt = block.settings.title | default: nil
                        if block.settings.custom_icon
                          echo block.settings.custom_icon | image_url: width: 24 | image_tag: alt: icon_alt
                        elsif block.settings.icon != blank
                          render 'icon', icon_name: block.settings.icon
                        endif
                      %}
                      </div>
                    {%- endif -%}
                    {%- if block.settings.title -%}
                      <p>{{ block.settings.title }}</p>
                    {%- endif -%}
                  </div>
                </div>
                {%- endif -%}
              {%- endfor -%}
            </div>
          </div>
        </cart-drawer-info-slider>
        {%- endif -%}
        <div class="cart-drawer__head">
          <p class="cart-drawer__title h4">
            {{- 'cart.title' | t -}}
            <span class="cart-drawer__title-counter">{{- cart.item_count -}}</span>
          </p>
          <button class="cart-drawer__close" type="button" onclick="this.closest('cart-drawer').close()" aria-label="{{- 'theme.actions.close' | t -}}" data-drawer-close>{%- render 'icon', icon_name: 'theme-close' -%}</button>
        </div>
        <div class="cart-drawer__top">
          {%- render 'shipping-bar', class: 'cart-drawer__bar' -%}
        </div>
        <div class="cart-drawer__body" id="CartDrawer-Body" data-cart-body>
          {%- if cart == empty -%}
            {%- liquid
              assign cart_empty_title = "cart.empty_title_html" | t
              assign cart_empty_subtitle = "cart.empty_subtitle" | t
              assign cart_empty_button_label = "cart.empty_button_label" | t
             -%}
            <div class="cart-drawer__empty">
                <h2 class="cart-drawer__empty-text">
                  {{- cart_empty_title -}}
                </h2>
                <span class="cart-drawer__empty-desc">{{ cart_empty_subtitle }}</span>
              {%- liquid
                if section.settings.button_url != blank
                  assign value = cart_empty_button_label
                  render 'button', type: 'link', href: section.settings.button_url, value: value, style: 'solid', fullwidth: false, class: 'button', button_style: 'button--outlined'
                  assign value = nil
                endif
              -%}
            </div>
          {%- else -%}
            <div class="cart-drawer__main">
              <cart-drawer-items class="cart-drawer-items {% if recommendations.products_count == 0 %}cart-drawer-items__full{% endif %}">
                <div class="cart-drawer__spinner">
                  {%- render 'loading-spinner' -%}
                </div>
                <form
                  action="{{- routes.cart_url -}}"
                  id="CartDrawer-Form"
                  class="cart-drawer__form"
                  method="post"
                >
                  <div class="cart-drawer__contents" id="CartDrawer-CartItems">
                    <div class="cart-drawer__items">
                      {%- for line_item in cart.items -%}
                        {%- render 'line-item', line_item: line_item -%}
                      {%- endfor -%}
                    </div>
                  </div>

                  <div class="custom-cart-blocks">
                    {%- for block in section.blocks -%}
                      {%- if block.type == 'upsell' and block.settings.product != blank -%}
                        {%- assign recommendation = block.settings.product -%}
                        <div class="custom-cart-block sneaker-wipes-block" {{ block.shopify_attributes }}>
                          {%- assign title_parts = block.settings.title | split: '&' -%}
                          <p class="block-title">
                            {{ title_parts[0] }}
                            {%- if title_parts.size > 1 -%}
                              <span class="green-text">& {{ title_parts[1] }}</span>
                            {%- endif -%}
                          </p>
                          <div class="block-content">
                            {%- if recommendation.featured_image -%}
                              {%- render 'image', image: recommendation.featured_image, alt: recommendation.featured_image.alt | escape, width: 60, height: 60 -%}
                            {%- endif -%}
                            <div class="block-details">
                              <p class="product-title"><a href="{{ recommendation.url }}" style="text-decoration: none; color: inherit;">{{ recommendation.title }}</a></p>
                              <p class="product-price">
                                <strong>{{ recommendation.price_min | money }}</strong> 
                                {%- if recommendation.compare_at_price_min > recommendation.price_min -%}
                                  <s>{{ recommendation.compare_at_price_min | money }}</s> 
                                  <span class="discount-badge">SAVE {{ recommendation.compare_at_price_min | minus: recommendation.price_min | money }}</span>
                                {%- endif -%}
                              </p>
                            </div>
                            <button type="button" class="button button--solid black-btn quick-cart-drawer__trigger quick-cart-drawer__trigger--recommendations" data-product-url="{{- recommendation.handle | prepend: '/products/'  -}}" onclick="preventDefault(event)">ADD</button>
                          </div>
                        </div>
                      {%- endif -%}

                      {%- if block.type == 'coupon' -%}
                        <div class="custom-cart-block coupons-block" {{ block.shopify_attributes }}>
                          <div class="coupon-available">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#228b22" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path><line x1="7" y1="7" x2="7.01" y2="7"></line></svg>
                            <span>{{ block.settings.title }}</span>
                            <span class="chevron-right">›</span>
                          </div>
                          <div class="coupon-more">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#228b22" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path><line x1="7" y1="7" x2="7.01" y2="7"></line></svg>
                            <span>{{ block.settings.more_offers_text }}</span>
                            <span class="view-all">{{ block.settings.view_all_text }}</span>
                          </div>
                        </div>
                      {%- endif -%}

                      {%- if block.type == 'cross_sell' and block.settings.product != blank -%}
                        {%- assign recommendation = block.settings.product -%}
                        <div class="custom-cart-block bundle-save-block" {{ block.shopify_attributes }}>
                          <div class="bundle-content">
                            <p class="bundle-title">{{ block.settings.title }}</p>
                            <p class="bundle-desc"><a href="{{ recommendation.url }}" style="text-decoration: none; color: inherit;">{{ block.settings.desc_prefix }} </a>
                              {%- if recommendation.compare_at_price_min > recommendation.price_min -%}
                                <s>{{ recommendation.compare_at_price_min | money }}</s>
                              {%- endif -%}
                              <strong>{{ recommendation.price_min | money }}</strong>
                            </p>
                          </div>
                          <button type="button" class="button button--solid black-btn quick-cart-drawer__trigger quick-cart-drawer__trigger--recommendations" data-product-url="{{- recommendation.handle | prepend: '/products/'  -}}" onclick="preventDefault(event)">ADD</button>
                        </div>
                      {%- endif -%}
                    {%- endfor -%}
                  </div>
                </form>
              </cart-drawer-items>
              {%- if settings.enable_cart_upsell -%}
                {%- render 'product-recommendations', area: 'cart-drawer', class: 'cart-drawer__recommendations', product_id: cart.items[0].product_id -%}
              {%- endif -%}
            </div>

            <div class="cart-drawer__bottom">
              <div class="cart-drawer__summary">
                <form
                  action="{{- routes.cart_url -}}"
                  id="CartDrawer-FormSummary"
                  class="cart-drawer__form-summary"
                  method="post"
                >
                  <div id="cart-summary">
                    <div class="cart-drawer__summary-total-wrapper">
                      <div class="cart-drawer__estimated-total">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path><polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline><line x1="12" y1="22.08" x2="12" y2="12"></line></svg>
                        <span class="estimated-text">Estimated total</span>
                      </div>
                      <div class="cart-drawer__total-amount">
                        <div class="cart-drawer__prices-wrapper">
                          {%- if cart.original_total_price > cart.total_price -%}
                            <s class="cart-drawer__original-price">{{ cart.original_total_price | money }}</s>
                          {%- endif -%}
                          <span class="cart-drawer__total-price" data-cart-total-price="{{- cart.total_price -}}">
                            {{- cart.total_price | money -}}
                          </span>
                          <svg class="icon icon-chevron-up" viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none"><polyline points="18 15 12 9 6 15"></polyline></svg>
                        </div>
                        {%- if cart.original_total_price > cart.total_price -%}
                          <div class="cart-drawer__saved-text">You saved {{ cart.original_total_price | minus: cart.total_price | money }}!</div>
                        {%- endif -%}
                      </div>
                    </div>
                    {%- if cart.cart_level_discount_applications.size > 0 -%}
                      <ul class="cart-drawer__summary-discounts list-unstyled" role="list" aria-label="{{- 'customer.order.discount' | t -}}">
                        {%- for discount in cart.cart_level_discount_applications -%}
                          <li>
                            {%- render 'icon', icon_name: 'theme-sale-tag' -%}
                            <span>
                              {{ discount.title }}
                              (-{{ discount.total_allocated_amount | money }})
                            </span>
                          </li>
                        {%- endfor -%}
                      </ul>
                    {%- endif -%}
                    <div class="cart-drawer__summary-actions">
                      {%- if settings.show_cart_terms == 'both' or settings.show_cart_terms == 'cart_drawer' -%}
                        {%- assign terms_text = settings.cart_terms | replace: '<p>', '' | replace: '</p>', '' -%}
                        <div class="cart-drawer__terms">
                          <div class="checkbox checkbox--plain">
                            <input type="checkbox" name="terms" required id="Terms-Conditions">
                            <label for="Terms-Conditions">
                              {{- terms_text -}}
                            </label>
                          </div>
                        </div>
                      {%- endif -%}
                      <div class="cart-drawer__action-buttons custom-checkout-wrapper">
                        <button type="submit" name="checkout" class="button button--solid button--full-width custom-checkout-btn">
                          <span class="checkout-text">Checkout</span>
                          <span class="checkout-icons">
                            <svg viewBox="0 0 24 24" width="24" height="24" style="background:#fff;border-radius:50%;padding:2px;"><circle cx="12" cy="12" r="10" fill="#00baf2"/><text x="12" y="16" font-size="10" font-family="Arial" font-weight="bold" fill="white" text-anchor="middle">Pay</text></svg>
                            <svg viewBox="0 0 24 24" width="24" height="24" style="background:#fff;border-radius:50%;padding:2px;"><circle cx="12" cy="12" r="10" fill="#5f259f"/><text x="12" y="16" font-size="10" font-family="Arial" font-weight="bold" fill="white" text-anchor="middle">Pe</text></svg>
                            <svg viewBox="0 0 24 24" width="24" height="24" style="background:#fff;border-radius:50%;padding:2px;"><circle cx="12" cy="12" r="10" fill="#ffffff"/><path d="M12 2A10 10 0 0 0 2 12A10 10 0 0 0 12 22A10 10 0 0 0 22 12A10 10 0 0 0 12 2M15 11H9V13H12V15H9V17H15V15H11V13H15V11Z" fill="#ea4335"/></svg>
                          </span>
                        </button>
                      </div>
                    </div>
                  </div>
                </form>
              </div>
            </div>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</cart-drawer>
