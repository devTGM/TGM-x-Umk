{%- comment -%}
  Structured GEO / AEO / AI-Citation data hub for GHOST Lifestyle Supplements in India.
  Rendered on /collections/ghost-supplements-india (and /collections/ghost) via collection template (`ghost_ai_summary`)
  and as a fallback inside snippets/ghost-collection-seo-content.liquid.
{%- endcomment -%}

{%- liquid
  assign ghost_col = collection
  assign is_ghost_col_context = false
  if ghost_col != blank
    if ghost_col.handle == 'ghost-supplements-india' or ghost_col.handle == 'ghost'
      assign is_ghost_col_context = true
    endif
  endif
  unless is_ghost_col_context
    assign ghost_col = collections['ghost-supplements-india']
    if ghost_col == blank or ghost_col.products.size == 0
      if collections['ghost'] != blank and collections['ghost'].products.size > 0
        assign ghost_col = collections['ghost']
      elsif ghost_col == blank
        assign ghost_col = collections['ghost']
      endif
    endif
  endunless
  assign ghost_col_url = ghost_col.url | default: '/collections/ghost-supplements-india'
  assign ghost_prods = ghost_col.products
  assign ghost_total = ghost_col.products_count | default: ghost_prods.size | default: 0
  assign ghost_listed_count = ghost_prods.size | default: 0
  assign ghost_available_count = 0
  assign ghost_instant_count = 0
  assign ghost_min_price = 0
  assign ghost_max_price = 0

  if ghost_prods != blank
    for prod in ghost_prods limit: 50
      if prod.available
        assign ghost_available_count = ghost_available_count | plus: 1
      endif
      if prod.metafields.custom.instant_ship.value == true or prod.metafields.custom.instant_ship == true or prod.metafields.custom.instant_ship.value == 'true' or prod.metafields.custom.instant_ship == 'true'
        assign ghost_instant_count = ghost_instant_count | plus: 1
      endif
      if prod.price != blank and prod.price > 0
        if ghost_min_price == 0 or prod.price < ghost_min_price
          assign ghost_min_price = prod.price
        endif
        if prod.price > ghost_max_price
          assign ghost_max_price = prod.price
        endif
      endif
    endfor
  endif

  assign ghost_price_range = ''
  if ghost_min_price > 0
    assign min_fmt = ghost_min_price | money_without_trailing_zeros | strip_html | strip
    assign max_fmt = ghost_max_price | money_without_trailing_zeros | strip_html | strip
    if ghost_min_price < ghost_max_price
      assign ghost_price_range = min_fmt | append: ' – ' | append: max_fmt
    else
      assign ghost_price_range = min_fmt
    endif
  endif
-%}

