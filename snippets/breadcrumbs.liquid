{%- comment -%}
  Accepts:

  -class: {String} - Class to be applied
  -alignment?: {String} - Alignemnt of the links. Accepts: 'center'
  -product_collection?: {Collection} - Add's first collection if assigned to the breadcrumb
{%- endcomment -%}

{%- liquid
  assign alignment = alignment | default: ''
  if alignment != ''
    assign class = class | default: '' | append: 'breadcrumbs--' | append: alignment
  else
    assign class = class | default: ''
  endif

  assign active_collection = collection | default: product_collection
  assign active_collection_title = ''
  if active_collection != blank
    assign active_collection_lc = active_collection.title | strip | downcase
    if active_collection.handle == 'david-protein' or active_collection.handle == 'david'
      if active_collection_lc == 'david'
        assign active_collection_title = 'David Protein'
      else
        assign active_collection_title = active_collection.title
      endif
    else
      assign active_collection_title = active_collection.title
    endif
  endif

  assign crumb_position = 1
-%}

<nav class="breadcrumbs {{ class }} {{ template.name }}__breadcrumbs" role="navigation" aria-label="{{- 'theme.breadcrumb.label' | t -}}" itemscope itemtype="https://schema.org/BreadcrumbList">
  <ul class="breadcrumbs__list list-unstyled no-scrollbar" role="list">
    <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
      <a href="{{- routes.root_url -}}" itemprop="item">
        <span itemprop="name" class="breadcrumbs__link">{{- 'theme.breadcrumb.home' | t -}}</span>
      </a>
      <meta itemprop="position" content="{{ crumb_position }}" />
    </li>

    <li class="breadcrumbs__separator">/</li>

    {%- if template.name == 'product' and active_collection != blank and active_collection.url != blank -%}
      {%- assign crumb_position = crumb_position | plus: 1 -%}
      <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
        <a href="{{- active_collection.url -}}" itemprop="item">
          <span itemprop="name" class="breadcrumbs__link">{{- active_collection_title | escape -}}</span>
        </a>
        <meta itemprop="position" content="{{ crumb_position }}" />
      </li>
      <li class="breadcrumbs__separator">/</li>
    {%- endif -%}

    {%- if template.name == 'article' and blog != blank -%}
      {%- assign crumb_position = crumb_position | plus: 1 -%}
      <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
        <a href="{{- blog.url -}}" title="{{- blog.title | escape -}}" itemprop="item">
          <span itemprop="name" class="breadcrumbs__link">{{- blog.title | escape -}}</span>
        </a>
        <meta itemprop="position" content="{{ crumb_position }}" />
      </li>
      <li class="breadcrumbs__separator">/</li>
    {%- endif -%}

    {%- assign crumb_position = crumb_position | plus: 1 -%}
    <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
      <span itemprop="name">
        {%- if template.name == 'index' -%}
          {{- 'theme.breadcrumb.home' | t -}}
        {%- elsif template.name == 'collection' -%}
          {{- active_collection_title | default: collection.title | escape -}}
        {%- elsif template.name == 'product' -%}
          {{- product.title | escape -}}
        {%- elsif template.name == 'article' -%}
          {{- article.title | escape -}}
        {%- elsif template.name == 'page' -%}
          {{- page_title | escape -}}
        {%- elsif template.name == 'search' -%}
          {{- 'theme.breadcrumb.search' | t -}}
        {%- else -%}
          {{- page_title | escape -}}
        {%- endif -%}
        {% comment %} {%- if template.name != 'search' -%}
          {{- page_title | escape -}}
        {%- else -%}
          {{- 'theme.breadcrumb.search' | t -}}
        {%- endif -%} {% endcomment %}
      </span>
      <meta itemprop="position" content="{{ crumb_position }}" />
    </li>
  </ul>
</nav>
