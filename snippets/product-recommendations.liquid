{%- liquid
  assign product_id = product_id | default: product.id
  assign product_recommendations_icon = icon | default: 'theme-package'
  assign product_recommendations_title = title | default: settings.cart_upsell_title | default: ''
  assign product_recommendations_limit = limit | default: 8
-%}

{{- 'component-product-recommendations.aio.min.css' | asset_url | stylesheet_tag -}}
<script src="{{ 'product-recommendations.js' | asset_url }}" defer="defer"></script>

<product-recommendations
  class="product-recommendations hidden {{ class }} color-{{ settings.color_scheme_for_upsell }}"
  data-url="{{- routes.product_recommendations_url -}}?section_id={{- section.id -}}&product_id={{- product_id -}}&limit={{- product_recommendations_limit -}}&intent={{ intent | default: 'complementary' }}"
  data-recommendation-area="{{- area -}}"
>
  {%- if product_recommendations_title != blank -%}
    <h5 class="product-recommendations__title{% if template.name == 'cart' %} heading-static{% endif %}">
      {%- if icon -%}
        {% render 'icon', icon_name: product_recommendations_icon %}
      {%- endif -%}
      {{- product_recommendations_title | escape -}}
    </h5>
  {%- endif -%}

  <div class="{% if area != 'cart-drawer' %}swiper {% endif %}product-recommendations__body">
    <div class="product-recommendations__items {% if area != 'cart-drawer' %}swiper-wrapper{% else %}custom-cart-blocks{% endif %}" data-recommendations>
      {%- if recommendations.performed and recommendations.products_count > 0 -%}
        {%- if area == 'cart-drawer' -%}
          {%- assign rec_count = 0 -%}
          {%- for recommendation in recommendations.products limit: 5 -%}
            {%- if recommendation.id == product_id or recommendation.handle == product_id -%}{%- continue -%}{%- endif -%}
            {%- assign rec_count = rec_count | plus: 1 -%}
            {%- if rec_count == 1 -%}
              <div class="custom-cart-block sneaker-wipes-block">
                <div class="block-content">
                  {%- if recommendation.featured_image -%}
                    {%- render 'image', image: recommendation.featured_image, alt: recommendation.featured_image.alt | escape, width: 60, height: 60 -%}
                  {%- endif -%}
                  <div class="block-details">
                    <p class="product-title"><a href="{{ recommendation.url }}" style="text-decoration: none; color: inherit;">{{ recommendation.title }}</a></p>
                    <p class="product-price">
                      <strong>{{ recommendation.price_min | money }}</strong> 
                      {%- if recommendation.compare_at_price_min > recommendation.price_min -%}
                        <s>{{ recommendation.compare_at_price_min | money }}</s> 
                        <span class="discount-badge">SAVE {{ recommendation.compare_at_price_min | minus: recommendation.price_min | money }}</span>
                      {%- endif -%}
                    </p>
                  </div>
                  <button type="button" class="custom-add-btn block-add-btn quick-cart-drawer__trigger quick-cart-drawer__trigger--recommendations" data-product-url="{{- recommendation.handle | prepend: '/products/'  -}}" onclick="preventDefault(event)"><span>+</span> ADD</button>
                </div>
              </div>
            {%- elsif rec_count == 2 -%}
              <div class="custom-cart-block bundle-save-block">
                <div class="bundle-content">
                  <p class="bundle-title">BUNDLE & SAVE</p>
                  <p class="bundle-desc"><a href="{{ recommendation.url }}" style="text-decoration: none; color: inherit;">{{ recommendation.title }} for </a>
                    {%- if recommendation.compare_at_price_min > recommendation.price_min -%}
                      <s>{{ recommendation.compare_at_price_min | money }}</s>
                    {%- endif -%}
                    <strong>{{ recommendation.price_min | money }}</strong>
                  </p>
                </div>
                <button type="button" class="custom-add-btn block-add-btn quick-cart-drawer__trigger quick-cart-drawer__trigger--recommendations" data-product-url="{{- recommendation.handle | prepend: '/products/'  -}}" onclick="preventDefault(event)"><span>+</span> ADD</button>
              </div>
            {%- elsif rec_count == 3 -%}
              <div class="custom-cart-block bestseller-slider-container">
                <div class="bestseller-header">
                  <h3>Add Our Best Selling Items</h3>
                </div>
                <div class="swiper product-recommendations__body">
                  <div class="swiper-wrapper bestseller-wrapper">
                    <div class="swiper-slide bestseller-slide">
                      <div class="bestseller-card">
                        <div class="bestseller-card-top">
                          <div class="bestseller-image">
                            {%- if recommendation.featured_image -%}
                              {%- render 'image', image: recommendation.featured_image, alt: recommendation.featured_image.alt | escape -%}
                            {%- endif -%}
                          </div>
                          <div class="bestseller-info">
                            <p class="title">{{ recommendation.title }}</p>
                            <p class="price">{{ recommendation.price_min | money }}</p>
                          </div>
                        </div>
                        <button type="button" class="custom-add-btn carousel-add-btn quick-cart-drawer__trigger quick-cart-drawer__trigger--recommendations" data-product-url="{{- recommendation.handle | prepend: '/products/'  -}}" onclick="preventDefault(event)">
                          <span>+</span> ADD
                        </button>
                      </div>
                    </div>
            {%- else -%}
                    <div class="swiper-slide bestseller-slide">
                      <div class="bestseller-card">
                        <div class="bestseller-card-top">
                          <div class="bestseller-image">
                            {%- if recommendation.featured_image -%}
                              {%- render 'image', image: recommendation.featured_image, alt: recommendation.featured_image.alt | escape -%}
                            {%- endif -%}
                          </div>
                          <div class="bestseller-info">
                            <p class="title">{{ recommendation.title }}</p>
                            <p class="price">{{ recommendation.price_min | money }}</p>
                          </div>
                        </div>
                        <button type="button" class="custom-add-btn carousel-add-btn quick-cart-drawer__trigger quick-cart-drawer__trigger--recommendations" data-product-url="{{- recommendation.handle | prepend: '/products/'  -}}" onclick="preventDefault(event)">
                          <span>+</span> ADD
                        </button>
                      </div>
                    </div>
            {%- endif -%}
          {%- endfor -%}
          {%- if rec_count >= 3 -%}
                  </div>
                  <div class="swiper-button-next"></div>
                  <div class="swiper-button-prev"></div>
                </div>
              </div>
          {%- endif -%}
        {%- else -%}
          {%- for recommendation in recommendations.products limit: product_recommendations_limit -%}

            <a href="{{- recommendation.url -}}" class="product-recommendations__item swiper-slide">

              {%- if recommendation.featured_image -%}
                <div class="media product-recommendations__item-media">
                  {%- render 'image', image: recommendation.featured_image, alt: recommendation.featured_image.alt | escape -%}
                </div>
              {%- endif -%}

              <div class="product-recommendations__item-details">
                <div>
                  <h6 class="product-recommendations__item-title">
                    {{- recommendation.title | escape -}}
                  </h6>

                  <p class="product-recommendations__item-price">
                    {%- if recommendation.compare_at_price_min > recommendation.price_min -%}
                      <span class="visually-hidden">{{- 'product.price_regular' | t -}}</span>
                      <del>{{- recommendation.compare_at_price_min | money -}}</del>
                      <span class="visually-hidden">{{- 'product.price_sale' | t -}}</span>
                      <ins>{{- recommendation.price_min | money -}}</ins>
                    {%- else -%}
                      <span class="visually-hidden">{{- 'product.price_regular' | t -}}</span>
                      {{- recommendation.price_min | money -}}
                    {%- endif -%}
                  </p>
                </div>

                {%- if settings.product_card_enable_quick_add_to_cart_button -%}
                  <button
                    type="button"
                    class="quick-cart-drawer__trigger quick-cart-drawer__trigger--recommendations button button--text"
                    aria-expanded="false"
                    onclick="preventDefault(event)"
                    aria-controls="quick-cart-drawer"
                    data-product-url="{{- recommendation.handle | prepend: '/products/'  -}}"
                  >
                    {{- 'cart.quick_add' | t -}}
                    <div class="quick-cart-drawer__trigger--loading">
                      {%- render 'loading-spinner' -%}
                    </div>
                  </button>
                {%- endif -%}
              </div>

            </a>
          {%- endfor -%}
        {%- endif -%}
      {%- endif -%}
    </div>
  </div>
</product-recommendations>
