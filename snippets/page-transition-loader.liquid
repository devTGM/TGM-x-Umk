{% comment %}
  Ultra-Smooth Page Transition Loader with Store Logo
  Hardware-accelerated 60fps/120fps smooth transition screen
{% endcomment %}

<div id="page-transition-loader" class="page-transition-loader" aria-hidden="true">
  <div class="page-transition-loader__inner">
    <div class="page-transition-loader__logo-container">
      <img
        src="{{ 'UK-Logo_768dfaa3-0466-45b5-b9e8-2d1bae580e2d.png' | file_img_url: '400x' }}"
        alt="{{ shop.name | escape }}"
        class="page-transition-loader__logo"
        width="150"
        height="75"
        loading="eager"
      />
    </div>
    <div class="page-transition-loader__progress">
      <div class="page-transition-loader__progress-bar"></div>
    </div>
  </div>
</div>

<style>
  .page-transition-loader {
    position: fixed !important;
    inset: 0 !important;
    width: 100% !important;
    height: 100% !important;
    background: #000000 !important;
    z-index: 99999999 !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.24s cubic-bezier(0.25, 1, 0.5, 1), visibility 0.24s cubic-bezier(0.25, 1, 0.5, 1);
    -webkit-backface-visibility: hidden;
    backface-visibility: hidden;
    -webkit-transform: translateZ(0);
    transform: translateZ(0);
  }

  .page-transition-loader.is-active {
    opacity: 1 !important;
    visibility: visible !important;
    pointer-events: auto !important;
  }

  .page-transition-loader__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 16px;
    padding: 20px;
    -webkit-transform: translate3d(0, 0, 0);
    transform: translate3d(0, 0, 0);
  }

  .page-transition-loader__logo-container {
    display: flex;
    align-items: center;
    justify-content: center;
    animation: loaderBreathe 1.6s ease-in-out infinite;
    -webkit-transform: translate3d(0, 0, 0);
    transform: translate3d(0, 0, 0);
    will-change: transform, opacity;
  }

  .page-transition-loader__logo {
    max-width: 150px;
    height: auto;
    object-fit: contain;
    display: block;
  }

  @media screen and (max-width: 749px) {
    .page-transition-loader__logo {
      max-width: 120px;
    }
  }

  .page-transition-loader__progress {
    width: 100px;
    height: 2px;
    background: rgba(255, 255, 255, 0.15);
    border-radius: 2px;
    overflow: hidden;
    position: relative;
    -webkit-transform: translateZ(0);
    transform: translateZ(0);
  }

  .page-transition-loader__progress-bar {
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
    width: 40%;
    background: #ffffff;
    border-radius: 2px;
    animation: loaderProgressAnim 1s cubic-bezier(0.4, 0, 0.2, 1) infinite;
    will-change: transform;
  }

  @keyframes loaderBreathe {
    0%, 100% {
      transform: scale3d(0.98, 0.98, 1);
      opacity: 0.9;
    }
    50% {
      transform: scale3d(1.02, 1.02, 1);
      opacity: 1;
    }
  }

  @keyframes loaderProgressAnim {
    0% {
      transform: translate3d(-100%, 0, 0);
    }
    100% {
      transform: translate3d(280%, 0, 0);
    }
  }
</style>

<script>
  (function () {
    const loader = document.getElementById("page-transition-loader");
    if (!loader) return;

    let timeoutId = null;

    function hide() {
      if (timeoutId) clearTimeout(timeoutId);
      loader.classList.remove("is-active");
    }

    function show() {
      loader.classList.add("is-active");
      if (timeoutId) clearTimeout(timeoutId);
      timeoutId = setTimeout(hide, 3000);
    }

    // Always ensure loader is hidden once page is interactive / loaded
    if (document.readyState === "complete" || document.readyState === "interactive") {
      hide();
    } else {
      window.addEventListener("DOMContentLoaded", hide);
      window.addEventListener("load", hide);
    }

    // Critical for iOS Safari back/forward swipe & buttons (BFCache)
    window.addEventListener("pageshow", function (e) {
      hide();
    });

    // Sync header logo src if available
    const headerLogo = document.querySelector(".header__logo-image, .header__logo img");
    if (headerLogo && headerLogo.src) {
      const loaderImg = loader.querySelector(".page-transition-loader__logo");
      if (loaderImg && headerLogo.src !== loaderImg.src) {
        loaderImg.src = headerLogo.src;
      }
    }

    // Trigger on clean page navigation clicks
    document.addEventListener("click", function (e) {
      const link = e.target.closest("a");
      if (!link || !link.href) return;

      if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
      if (e.defaultPrevented) return;
      if (link.target === "_blank") return;

      const rawHref = link.getAttribute("href") || "";
      if (
        rawHref.startsWith("#") ||
        rawHref.startsWith("javascript:") ||
        rawHref.startsWith("mailto:") ||
        rawHref.startsWith("tel:")
      ) {
        return;
      }

      if (
        link.closest(
          "[aria-controls], [data-drawer], cart-drawer, quick-cart-drawer, .open-size-chart, .button--close, .modal, .custom-add-btn, .product-card__add-to-cart--button"
        )
      ) {
        return;
      }

      try {
        const dest = new URL(link.href, window.location.origin);
        if (dest.origin === window.location.origin) {
          const isSamePage =
            dest.pathname === window.location.pathname && dest.search === window.location.search;
          if (!isSamePage) {
            show();
          }
        }
      } catch (err) {}
    });

    window.addEventListener("beforeunload", function () {
      show();
    });
  })();
</script>
