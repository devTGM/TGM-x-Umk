{% comment %}
  Ultra-Smooth Page Transition Loader with Store Logo
{% endcomment %}

<div id="page-transition-loader" class="page-transition-loader is-active" aria-hidden="true">
  <div class="page-transition-loader__inner">
    <div class="page-transition-loader__logo-container">
      <img
        src="{{ 'UK-Logo_768dfaa3-0466-45b5-b9e8-2d1bae580e2d.png' | file_img_url: '400x' }}"
        alt="{{ shop.name | escape }}"
        class="page-transition-loader__logo"
        width="150"
        height="75"
        loading="eager"
        fetchpriority="high"
      />
    </div>
    <div class="page-transition-loader__progress">
      <div class="page-transition-loader__progress-bar"></div>
    </div>
  </div>
</div>

<style>
  .page-transition-loader {
    position: fixed !important;
    inset: 0 !important;
    width: 100vw !important;
    height: 100vh !important;
    background: #000000 !important;
    z-index: 999999999 !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.3s cubic-bezier(0.25, 1, 0.5, 1), visibility 0.3s cubic-bezier(0.25, 1, 0.5, 1);
    -webkit-backface-visibility: hidden;
    backface-visibility: hidden;
    -webkit-transform: translateZ(0);
    transform: translateZ(0);
  }

  .page-transition-loader.is-active {
    opacity: 1 !important;
    visibility: visible !important;
    pointer-events: auto !important;
  }

  .page-transition-loader__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 16px;
    padding: 20px;
    -webkit-transform: translate3d(0, 0, 0);
    transform: translate3d(0, 0, 0);
  }

  .page-transition-loader__logo-container {
    display: flex;
    align-items: center;
    justify-content: center;
    animation: loaderBreathe 1.5s ease-in-out infinite;
    -webkit-transform: translate3d(0, 0, 0);
    transform: translate3d(0, 0, 0);
  }

  .page-transition-loader__logo {
    max-width: 140px;
    height: auto;
    object-fit: contain;
    display: block;
  }

  @media screen and (max-width: 749px) {
    .page-transition-loader__logo {
      max-width: 120px;
    }
  }

  .page-transition-loader__progress {
    width: 100px;
    height: 2px;
    background: rgba(255, 255, 255, 0.15);
    border-radius: 2px;
    overflow: hidden;
    position: relative;
    -webkit-transform: translateZ(0);
    transform: translateZ(0);
  }

  .page-transition-loader__progress-bar {
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
    width: 40%;
    background: #ffffff;
    border-radius: 2px;
    animation: loaderProgressAnim 1s cubic-bezier(0.4, 0, 0.2, 1) infinite;
  }

  @keyframes loaderBreathe {
    0%, 100% {
      transform: scale3d(0.97, 0.97, 1);
      opacity: 0.88;
    }
    50% {
      transform: scale3d(1.03, 1.03, 1);
      opacity: 1;
    }
  }

  @keyframes loaderProgressAnim {
    0% {
      transform: translate3d(-100%, 0, 0);
    }
    100% {
      transform: translate3d(280%, 0, 0);
    }
  }
</style>

<script>
  (function () {
    const loader = document.getElementById("page-transition-loader");
    if (!loader) return;

    let timeoutId = null;

    function hide() {
      if (timeoutId) clearTimeout(timeoutId);
      loader.classList.remove("is-active");
    }

    function show() {
      loader.classList.add("is-active");
      if (timeoutId) clearTimeout(timeoutId);
      timeoutId = setTimeout(hide, 3500);
    }

    // Smooth initial page load fade-out
    setTimeout(hide, 300);

    window.addEventListener("load", function () {
      setTimeout(hide, 200);
    });

    window.addEventListener("pageshow", function () {
      hide();
    });

    // Capture header logo src
    const headerLogo = document.querySelector(".header__logo-image, .header__logo img");
    if (headerLogo && headerLogo.src) {
      const loaderImg = loader.querySelector(".page-transition-loader__logo");
      if (loaderImg && headerLogo.src !== loaderImg.src) {
        loaderImg.src = headerLogo.src;
      }
    }

    // Global listener with capture: true so mobile drawers and menus do not block navigation trigger
    document.addEventListener(
      "click",
      function (e) {
        const link = e.target.closest("a");
        if (!link || !link.href) return;

        if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
        if (link.target === "_blank" || link.hasAttribute("download")) return;

        const rawHref = link.getAttribute("href") || "";
        if (
          rawHref.startsWith("#") ||
          rawHref.startsWith("javascript:") ||
          rawHref.startsWith("mailto:") ||
          rawHref.startsWith("tel:")
        ) {
          return;
        }

        // Only ignore non-navigational action buttons
        if (
          link.classList.contains("quick-cart-drawer__trigger") ||
          link.classList.contains("custom-add-btn") ||
          link.classList.contains("button--close") ||
          link.classList.contains("open-size-chart")
        ) {
          return;
        }

        try {
          const dest = new URL(link.href, window.location.origin);
          if (dest.origin === window.location.origin) {
            const isDifferent =
              dest.pathname !== window.location.pathname ||
              dest.search !== window.location.search;
            if (isDifferent) {
              show();
            }
          }
        } catch (err) {}
      },
      true
    );

    window.addEventListener("beforeunload", function () {
      show();
    });
  })();
</script>
