{% comment %}
  Ultra-Smooth Page Transition Loader with Store Logo
{% endcomment %}

{% liquid
  assign loader_logo_url = '//www.unmatchedsupply.com/cdn/shop/files/IMG_1637_JPG.jpg?v=1788777744&width=400'
  if settings.logo != blank
    assign loader_logo_url = settings.logo | image_url: width: 400
  elsif 'IMG_1637_JPG.jpg' | file_img_url: '400x' != blank
    assign loader_logo_url = 'IMG_1637_JPG.jpg' | file_img_url: '400x'
  endif
%}

<div id="page-transition-loader" class="page-transition-loader is-active" aria-hidden="true">
  <div class="page-transition-loader__inner">
    <div class="page-transition-loader__logo-container">
      <img
        id="page-transition-loader-img"
        src="{{ loader_logo_url }}"
        alt="{{ shop.name | escape }}"
        class="page-transition-loader__logo"
        width="160"
        height="80"
        loading="eager"
        fetchpriority="high"
      />
    </div>
    <div class="page-transition-loader__progress">
      <div class="page-transition-loader__progress-bar"></div>
    </div>
  </div>
</div>

<style>
  .page-transition-loader {
    position: fixed !important;
    inset: 0 !important;
    width: 100vw !important;
    height: 100vh !important;
    background: #000000 !important;
    z-index: 999999999 !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.3s cubic-bezier(0.25, 1, 0.5, 1), visibility 0.3s cubic-bezier(0.25, 1, 0.5, 1);
    -webkit-backface-visibility: hidden;
    backface-visibility: hidden;
    -webkit-transform: translateZ(0);
    transform: translateZ(0);
  }

  .page-transition-loader.is-active {
    opacity: 1 !important;
    visibility: visible !important;
    pointer-events: auto !important;
  }

  .page-transition-loader__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 16px;
    padding: 20px;
    -webkit-transform: translate3d(0, 0, 0);
    transform: translate3d(0, 0, 0);
  }

  .page-transition-loader__logo-container {
    display: flex;
    align-items: center;
    justify-content: center;
    animation: loaderBreathe 1.5s ease-in-out infinite;
    -webkit-transform: translate3d(0, 0, 0);
    transform: translate3d(0, 0, 0);
  }

  .page-transition-loader__logo {
    max-width: 150px;
    max-height: 80px;
    width: auto;
    height: auto;
    object-fit: contain;
    display: block;
  }

  @media screen and (max-width: 749px) {
    .page-transition-loader__logo {
      max-width: 130px;
      max-height: 70px;
    }
  }

  .page-transition-loader__progress {
    width: 100px;
    height: 2px;
    background: rgba(255, 255, 255, 0.15);
    border-radius: 2px;
    overflow: hidden;
    position: relative;
    -webkit-transform: translateZ(0);
    transform: translateZ(0);
  }

  .page-transition-loader__progress-bar {
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
    width: 40%;
    background: #ffffff;
    border-radius: 2px;
    animation: loaderProgressAnim 1s cubic-bezier(0.4, 0, 0.2, 1) infinite;
  }

  @keyframes loaderBreathe {
    0%, 100% {
      transform: scale3d(0.97, 0.97, 1);
      opacity: 0.88;
    }
    50% {
      transform: scale3d(1.03, 1.03, 1);
      opacity: 1;
    }
  }

  @keyframes loaderProgressAnim {
    0% {
      transform: translate3d(-100%, 0, 0);
    }
    100% {
      transform: translate3d(280%, 0, 0);
    }
  }
</style>

<script>
  (function () {
    const loader = document.getElementById("page-transition-loader");
    if (!loader) return;
    const loaderImg =
      document.getElementById("page-transition-loader-img") ||
      loader.querySelector(".page-transition-loader__logo");

    function getActiveLogoSrc() {
      const headerLogo = document.querySelector(
        ".header__logo-image, .header__logo-image-transparent, .header__logo img, .footer__brand-logo img, header a[href*='/'] img"
      );
      if (headerLogo) {
        return headerLogo.currentSrc || headerLogo.src;
      }
      return null;
    }

    function isOldLogo(url) {
      if (!url) return false;
      const lower = url.toLowerCase();
      return lower.includes("uk_logo") || lower.includes("uk-logo") || lower.includes("768dfaa3");
    }

    function updateLoaderLogo(src) {
      if (src && loaderImg && loaderImg.src !== src && !isOldLogo(src)) {
        loaderImg.src = src;
      }
    }

    // Purge any stale cache of the old logo from previous sessions
    try {
      sessionStorage.removeItem("umk_logo_url");
      const existingCached = sessionStorage.getItem("ums_logo_url");
      if (existingCached && isOldLogo(existingCached)) {
        sessionStorage.removeItem("ums_logo_url");
      }
    } catch (err) {}

    // Restore cached logo immediately from sessionStorage if available
    try {
      const cachedLogo = sessionStorage.getItem("ums_logo_url");
      if (cachedLogo && !isOldLogo(cachedLogo)) {
        updateLoaderLogo(cachedLogo);
      }
    } catch (err) {}

    function syncAndCacheLogo() {
      const activeLogo = getActiveLogoSrc();
      if (activeLogo && !isOldLogo(activeLogo)) {
        updateLoaderLogo(activeLogo);
        try {
          sessionStorage.setItem("ums_logo_url", activeLogo);
        } catch (err) {}
      }
    }

    // Sync on DOM ready and window load
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", syncAndCacheLogo);
    } else {
      syncAndCacheLogo();
    }
    window.addEventListener("load", syncAndCacheLogo);

    let timeoutId = null;

    function hide() {
      if (timeoutId) clearTimeout(timeoutId);
      loader.classList.remove("is-active");
    }

    function show() {
      syncAndCacheLogo();
      loader.classList.add("is-active");
      if (timeoutId) clearTimeout(timeoutId);
      timeoutId = setTimeout(hide, 3500);
    }

    // Smooth initial page load fade-out
    setTimeout(hide, 300);

    window.addEventListener("load", function () {
      setTimeout(hide, 150);
    });

    window.addEventListener("pageshow", function () {
      hide();
    });

    // Global listener with capture: true so mobile drawers and menus do not block navigation trigger
    document.addEventListener(
      "click",
      function (e) {
        const link = e.target.closest("a");
        if (!link || !link.href) return;

        if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
        if (link.target === "_blank" || link.hasAttribute("download")) return;

        const rawHref = link.getAttribute("href") || "";
        if (
          rawHref.startsWith("#") ||
          rawHref.startsWith("javascript:") ||
          rawHref.startsWith("mailto:") ||
          rawHref.startsWith("tel:")
        ) {
          return;
        }

        // Only ignore non-navigational action buttons
        if (
          link.classList.contains("quick-cart-drawer__trigger") ||
          link.classList.contains("custom-add-btn") ||
          link.classList.contains("button--close") ||
          link.classList.contains("open-size-chart")
        ) {
          return;
        }

        try {
          const dest = new URL(link.href, window.location.origin);
          if (dest.origin === window.location.origin) {
            const isDifferent =
              dest.pathname !== window.location.pathname ||
              dest.search !== window.location.search;
            if (isDifferent) {
              show();
            }
          }
        } catch (err) {}
      },
      true
    );

    window.addEventListener("beforeunload", function () {
      show();
    });
  })();
</script>