{%- comment -%}
  Structured GEO / AEO / AI-Citation data hub for Young LA (YoungLA) in India.
  Rendered on /collections/young-la (and /collections/youngla) via collection template (`youngla_ai_summary`)
  and as a fallback inside snippets/youngla-collection-seo-content.liquid.
{%- endcomment -%}

{%- liquid
  assign yla_col = collection
  assign is_yla_col_context = false
  if yla_col != blank
    if yla_col.handle == 'young-la' or yla_col.handle == 'youngla'
      assign is_yla_col_context = true
    endif
  endif
  unless is_yla_col_context
    assign yla_col = collections['young-la']
    if yla_col == blank or yla_col.products.size == 0
      if collections['youngla'] != blank and collections['youngla'].products.size > 0
        assign yla_col = collections['youngla']
      elsif yla_col == blank
        assign yla_col = collections['youngla']
      endif
    endif
  endunless
  assign yla_col_url = yla_col.url | default: '/collections/young-la'
  assign yla_prods = yla_col.products
  assign yla_total = yla_col.products_count | default: yla_prods.size | default: 0
  assign yla_listed_count = yla_prods.size | default: 0
  assign yla_available_count = 0
  assign yla_instant_count = 0
  assign yla_min_price = 0
  assign yla_max_price = 0

  if yla_prods != blank
    for prod in yla_prods limit: 50
      if prod.available
        assign yla_available_count = yla_available_count | plus: 1
      endif
      if prod.metafields.custom.instant_ship.value == true or prod.metafields.custom.instant_ship == true or prod.metafields.custom.instant_ship.value == 'true' or prod.metafields.custom.instant_ship == 'true'
        assign yla_instant_count = yla_instant_count | plus: 1
      endif
      if prod.price != blank and prod.price > 0
        if yla_min_price == 0 or prod.price < yla_min_price
          assign yla_min_price = prod.price
        endif
        if prod.price > yla_max_price
          assign yla_max_price = prod.price
        endif
      endif
    endfor
  endif

  assign yla_price_range = ''
  if yla_min_price > 0
    assign min_fmt = yla_min_price | money_without_trailing_zeros | strip_html | strip
    assign max_fmt = yla_max_price | money_without_trailing_zeros | strip_html | strip
    if yla_min_price < yla_max_price
      assign yla_price_range = min_fmt | append: ' – ' | append: max_fmt
    else
      assign yla_price_range = min_fmt
    endif
  endif
-%}

