<div class="quick-cart-product product">
  {% if product.media.size > 0 %}
    <div class="quick-cart-drawer__slider-wrapper">
      <div class="swiper quick-cart-drawer__media-swiper">
        <div class="swiper-wrapper">
          {%- for media in product.media -%}
            <div class="swiper-slide" data-media-id="{{ media.id }}" data-index="{{ forloop.index0 }}">
              <div class="quick-cart-media-box">
                <img
                  src="{{ media.preview_image | image_url: width: 600 }}"
                  alt="{{ media.alt | default: product.title | escape }}"
                  loading="lazy"
                />
              </div>
            </div>
          {%- endfor -%}
        </div>
      </div>
    </div>
  {% endif %}

  {% comment %} PRODUCT INFO & DETAILS {% endcomment %}
  <div class="product__content">
    <div class="quick-cart-product-header">
      <h3 class="quick-cart-product-title">{{- product.title | escape -}}</h3>
      <div class="quick-cart-product-price">
        {%- render 'price', product: product, use_variant: true -%}
      </div>

      {%- assign emi_amount = product.selected_or_first_available_variant.price | divided_by: 4 | money_without_trailing_zeros | remove: 'Rs.' | remove: '₹' | strip -%}
      <div class="snapmint-emi-container" data-snapmint-container>
        <div class="snapmint-emi-content">
          <div class="snapmint-emi-line1">
            <span class="snapmint-tag">NEW</span>
            <span class="snapmint-main-text">OR <strong data-snapmint-emi-val>₹{{ emi_amount }}</strong> /MONTH (4 MONTHS)</span>
          </div>
          <div class="snapmint-emi-line2">
            <span>0% EMI ON <span class="snapmint-upi-logo">UPI</span> • <strong>snapmint</strong></span>
          </div>
        </div>
        <button type="button" class="snapmint-emi-btn">BUY ON EMI</button>
      </div>
    </div>

    <product-card class="product-card product-card__quick-cart">
      {%- assign variants = product.variants -%}
      {%- assign current_variant = product.selected_or_first_available_variant -%}

      <div class="product-card__variants">
        {%- for option in product.options_with_values -%}
          {%- assign option_pos = forloop.index0 -%}
          {%- assign opt_idx = forloop.index -%}
          {%- assign opt_name_down = option.name | downcase -%}
          {%- assign clean_opt_name = option.name | remove: ':' | strip -%}

          {%- if option.values.size == 1 and opt_name_down contains 'delivery' or opt_name_down contains 'shipping' or opt_name_down contains 'timeline' -%}
            <div class="quick-cart-delivery-badge">
              <span class="delivery-icon">⚡</span>
              <span class="delivery-text">{{ clean_opt_name }}: <strong>{{ option.values.first }}</strong></span>
              <input type="hidden" name="{{ product.id }}-option[{{ opt_idx }}]" value="{{ option.values.first }}" class="variant-option-radio-input">
            </div>
          {%- else -%}
            <fieldset class="product__variant-options js-product-card-options" data-option-index="{{ opt_idx }}">
              <legend>
                <span class="option-name">{{ clean_opt_name }}:</span>
                <span class="option-selected-val" data-selected-variant>{{ current_variant.options[option_pos] | default: option.selected_value }}</span>
              </legend>
              <div class="variant-pills-row">
                {%- for val in option.values -%}
                  {%- assign is_selected = false -%}
                  {%- if val == current_variant.options[option_pos] -%}
                    {%- assign is_selected = true -%}
                  {%- endif -%}

                  {%- assign is_available = false -%}
                  {%- for v in product.variants -%}
                    {%- if v.options[option_pos] == val and v.available -%}
                      {%- assign is_available = true -%}
                      {%- break -%}
                    {%- endif -%}
                  {%- endfor -%}

                  {%- assign input_id = product.id | append: '-opt-' | append: opt_idx | append: '-' | append: forloop.index -%}
                  {%- assign input_name = product.id | append: '-option[' | append: opt_idx | append: ']' -%}

                  <label class="button--variant {% if is_selected %}checked{% endif %} {% unless is_available %}disabled{% endunless %}" for="{{ input_id }}">
                    <input
                      type="radio"
                      id="{{ input_id }}"
                      name="{{ input_name }}"
                      value="{{ val | escape }}"
                      {% if is_selected %}checked="checked"{% endif %}
                      {% unless is_available %}disabled="disabled"{% endunless %}
                      class="variant-option-radio-input visually-hidden"
                    >
                    <span>{{ val }}</span>
                  </label>
                {%- endfor -%}
              </div>
            </fieldset>
          {%- endif -%}
        {%- endfor -%}

        <script data-product-variants-json type="application/json">
          {{- variants | json -}}
        </script>
      </div>

      {%- form 'product', product,
        class: 'product-card__add-to-cart--form product__form',
        novalidate: 'novalidate'
      -%}
        <input type="hidden" name="id" value="{{- current_variant.id -}}">
        <div class="quick-cart-actions-row">
          <div class="product-selector__quantity">
            <div class="quantity__wrapper">
              <button class="quantity__button" name="decrement" type="button" aria-label="Decrease quantity">
                <svg width="12" height="2" viewBox="0 0 12 2" fill="none"><path d="M1 1H11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
              </button>
              <input class="quantity__input" type="number" name="quantity" min="1" max="99" value="1" aria-label="Quantity">
              <button class="quantity__button" name="increment" type="button" aria-label="Increase quantity">
                <svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M6 1V11M1 6H11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
              </button>
            </div>
          </div>
          <button type="submit" class="button product-card__submit-btn" {% unless current_variant.available %}disabled{% endunless %}>
            <span>{% if current_variant.available %}ADD TO CART{% else %}SOLD OUT{% endif %}</span>
          </button>
        </div>
        <div class="product-form__error-message-wrapper" role="alert" hidden>
          <span class="product-form__error-icon">{% render 'icon', icon_name: 'theme-warning' %}</span>
          <span class="product-form__error-message"></span>
        </div>
      {%- endform -%}
    </product-card>
  </div>
</div>
