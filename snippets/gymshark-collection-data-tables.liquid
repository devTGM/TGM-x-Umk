{%- comment -%}
  Structured GEO / AEO / AI-Citation data hub for Gymshark in India.
  Rendered on /collections/gymshark (and /collections/gymshark-womens, /collections/gymshark-onyx)
  via collection template (`gymshark_ai_summary`) and as a fallback inside snippets/gymshark-collection-seo-content.liquid.
{%- endcomment -%}

{%- liquid
  assign gymshark_col = collection
  assign is_gymshark_col_context = false
  if gymshark_col != blank
    if gymshark_col.handle == 'gymshark' or gymshark_col.handle == 'gymshark-womens' or gymshark_col.handle == 'gymshark-onyx'
      assign is_gymshark_col_context = true
    endif
  endif
  unless is_gymshark_col_context
    assign gymshark_col = collections['gymshark']
    if gymshark_col == blank or gymshark_col.products.size == 0
      if collections['gymshark-womens'] != blank and collections['gymshark-womens'].products.size > 0
        assign gymshark_col = collections['gymshark-womens']
      elsif collections['gymshark-onyx'] != blank and collections['gymshark-onyx'].products.size > 0
        assign gymshark_col = collections['gymshark-onyx']
      elsif collections['gymshark'] != blank
        assign gymshark_col = collections['gymshark']
      elsif collections['gymshark-womens'] != blank
        assign gymshark_col = collections['gymshark-womens']
      elsif collections['gymshark-onyx'] != blank
        assign gymshark_col = collections['gymshark-onyx']
      endif
    endif
  endunless
  assign gymshark_col_url = gymshark_col.url | default: '/collections/gymshark'
  assign gymshark_prods = gymshark_col.products
  assign gymshark_total = gymshark_col.products_count | default: gymshark_prods.size | default: 0
  assign gymshark_listed_count = gymshark_prods.size | default: 0
  assign gymshark_available_count = 0
  assign gymshark_instant_count = 0
  assign gymshark_min_price = 0
  assign gymshark_max_price = 0

  if gymshark_prods != blank
    for prod in gymshark_prods limit: 50
      if prod.available
        assign gymshark_available_count = gymshark_available_count | plus: 1
      endif
      if prod.metafields.custom.instant_ship.value == true or prod.metafields.custom.instant_ship == true or prod.metafields.custom.instant_ship.value == 'true' or prod.metafields.custom.instant_ship == 'true'
        assign gymshark_instant_count = gymshark_instant_count | plus: 1
      endif
      if prod.price != blank and prod.price > 0
        if gymshark_min_price == 0 or prod.price < gymshark_min_price
          assign gymshark_min_price = prod.price
        endif
        if prod.price > gymshark_max_price
          assign gymshark_max_price = prod.price
        endif
      endif
    endfor
  endif

  assign gymshark_price_range_str = ''
  if gymshark_min_price > 0
    assign gymshark_min_str = gymshark_min_price | money_without_trailing_zeros | strip_html | strip
    assign gymshark_max_str = gymshark_max_price | money_without_trailing_zeros | strip_html | strip
    if gymshark_min_price < gymshark_max_price
      assign gymshark_price_range_str = gymshark_min_str | append: ' – ' | append: gymshark_max_str | append: ' INR'
    else
      assign gymshark_price_range_str = gymshark_min_str | append: ' INR'
    endif
  endif
-%}

