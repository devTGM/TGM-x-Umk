{%- liquid
  assign site_url = shop.url | default: request.origin
  assign default_home_title = 'Unmatched Supply — Streetwear, Activewear & Sneakers India'
  assign default_brand_description = "Unmatched Supply (formerly Unmatched Kicks) is India's destination for 100% authentic Gymshark, YoungLA, Alo Yoga, Essentials, David Protein, sneakers & supplements."

  assign raw_shop_name = shop.name | strip
  assign raw_shop_name_lc = raw_shop_name | downcase
  if raw_shop_name == blank or raw_shop_name_lc contains 'unmatched kicks' or raw_shop_name_lc contains 'unamtched kicks' or raw_shop_name_lc == 'unmatchedsupply'
    assign canonical_site_name = 'Unmatched Supply'
  else
    assign canonical_site_name = raw_shop_name
  endif
  assign canonical_site_name_lc = canonical_site_name | strip | downcase

  assign meta_title = page_title | default: canonical_site_name
  if request.page_type == 'index'
    assign normalized_title = meta_title | strip | downcase
    if normalized_title == blank or normalized_title == raw_shop_name_lc or normalized_title == canonical_site_name_lc
      assign meta_title = default_home_title
    endif
  endif

  assign supplement_handles = '|david-protein|david|ghost-supplements-india|quest-protein-bars|quest-protein-bars-1|barbell-protein-bar|prime-protein|ryse|dymatize|raw|dragon-pharma|panda-supplements|supplements-instant-ship|'
  assign shop_desc_clean = shop.description | strip_html | strip_newlines | replace: 'authentic.Instant', 'authentic. Instant' | strip
  assign shop_desc_lc = shop_desc_clean | downcase
  assign raw_page_desc = page_description | strip_html | strip_newlines | replace: 'authentic.Instant', 'authentic. Instant' | strip
  assign raw_page_desc_lc = raw_page_desc | downcase

  assign has_custom_page_desc = true
  if raw_page_desc == blank or raw_page_desc_lc == raw_shop_name_lc or raw_page_desc_lc == canonical_site_name_lc
    assign has_custom_page_desc = false
  elsif request.page_type != 'index' and shop_desc_lc != blank and raw_page_desc_lc == shop_desc_lc
    assign has_custom_page_desc = false
  endif

  if request.page_type == 'collection' and collection != blank
    assign collection_handle_token = '|' | append: collection.handle | append: '|'
    if collection.handle == 'david-protein' or collection.handle == 'david'
      assign david_title_lc = meta_title | strip | downcase
      unless david_title_lc contains 'protein' and david_title_lc contains 'india'
        assign meta_title = 'David Protein Bar India – Shop David Protein | Unmatched Supply'
      endunless

      if has_custom_page_desc and raw_page_desc_lc contains 'protein' and raw_page_desc_lc contains 'india' and raw_page_desc.size >= 110
        assign meta_description = raw_page_desc
      else
        assign meta_description = 'Buy authentic David Protein bars in India at Unmatched Supply Mumbai. Shop Gold (28g) & Bronze (20g) 0g sugar 12-bar packs, Pan-India delivery & zero customs.'
      endif
    elsif has_custom_page_desc
      assign meta_description = raw_page_desc
    elsif supplement_handles contains collection_handle_token
      assign meta_description = 'Shop 100% authentic ' | append: collection.title | append: ' in India at Unmatched Supply. Verified imported fitness supplements with fast Pan-India delivery & zero customs.'
    else
      assign meta_description = 'Shop 100% authentic ' | append: collection.title | append: ' in India at Unmatched Supply. Verified global streetwear, activewear & lifestyle drops with Pan-India delivery & zero customs.'
    endif
  elsif request.page_type == 'product' and product != blank
    assign product_title_lc = product.title | strip | downcase
    assign product_vendor_lc = product.vendor | strip | downcase
    assign is_david_product = false
    if product_title_lc contains 'david protein' or product_vendor_lc contains 'david'
      assign is_david_product = true
    else
      for pcol in product.collections
        if pcol.handle == 'david-protein' or pcol.handle == 'david'
          assign is_david_product = true
          break
        endif
      endfor
    endif

    if is_david_product
      assign current_meta_title_lc = meta_title | strip | downcase
      unless current_meta_title_lc contains 'india'
        assign meta_title = meta_title | append: ' – India'
      endunless

      if has_custom_page_desc and raw_page_desc_lc contains 'india' and raw_page_desc.size >= 90
        assign meta_description = raw_page_desc
      else
        assign david_price = product.price | money_without_trailing_zeros | strip_html | strip
        assign meta_description = 'Buy authentic ' | append: product.title | append: ' in India for ' | append: david_price | append: ' at Unmatched Supply Mumbai. 0g sugar · Pan-India delivery & zero customs.'
      endif
    elsif has_custom_page_desc
      assign meta_description = raw_page_desc
    else
      assign meta_description = 'Buy authentic ' | append: product.title | append: ' in India at Unmatched Supply. Verified genuine with fast Pan-India delivery and zero customs fees.'
    endif
  elsif has_custom_page_desc
    assign meta_description = raw_page_desc
  elsif shop_desc_clean != blank and request.page_type == 'index'
    assign meta_description = shop_desc_clean
  else
    assign meta_description = default_brand_description
  endif

  assign meta_title_lc = meta_title | strip | downcase
  assign title_has_brand = false
  if meta_title_lc contains canonical_site_name_lc or meta_title_lc contains 'unmatched supply' or meta_title_lc contains 'unmatchedsupply'
    assign title_has_brand = true
  endif

  assign meta_url = canonical_url | default: site_url
  assign meta_type = 'website'
  assign og_image = page_image | default: shop.brand.cover_image | default: shop.brand.logo | default: settings.favicon

  if request.page_type == 'product'
    assign meta_type = 'product'
  elsif request.page_type == 'article'
    assign meta_type = 'article'
  elsif request.page_type == 'collection'
    assign meta_type = 'product.group'
  elsif request.page_type == 'password'
    assign meta_url = request.origin
  endif
-%}

{%- unless request.page_type == 'search' -%}
  <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1">
{%- endunless -%}
<link rel="alternate" type="text/plain" title="LLMs.txt" href="{{ site_url }}/llms.txt">

<title>{{- meta_title | escape -}}{%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' | escape }}"{% endif -%}{%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}{%- unless title_has_brand %} &ndash; {{ canonical_site_name | escape }}{% endunless -%}</title>

{%- if meta_description != blank -%}
  <meta name="description" content="{{ meta_description | escape }}">
{%- endif -%}

<meta property="og:site_name" content="{{ canonical_site_name | escape }}">
<meta property="og:url" content="{{ meta_url }}">
<meta property="og:title" content="{{ meta_title | escape }}">
<meta property="og:type" content="{{ meta_type }}">
<meta property="og:description" content="{{ meta_description | escape }}">

{%- if og_image -%}
  {%- liquid
    assign og_image_raw = og_image | image_url
    if og_image_raw contains 'http://' or og_image_raw contains 'https://'
      assign og_image_https = og_image_raw | replace: 'http://', 'https://'
      assign og_image_http = og_image_raw | replace: 'https://', 'http://'
    else
      assign og_image_https = 'https:' | append: og_image_raw
      assign og_image_http = 'http:' | append: og_image_raw
    endif
  -%}
  <meta property="og:image" content="{{ og_image_http }}">
  <meta property="og:image:secure_url" content="{{ og_image_https }}">
  {%- if og_image.width -%}
    <meta property="og:image:width" content="{{ og_image.width }}">
  {%- endif -%}
  {%- if og_image.height -%}
    <meta property="og:image:height" content="{{ og_image.height }}">
  {%- endif -%}
{%- endif -%}

{%- if request.page_type == 'product' -%}
  <meta property="og:price:amount" content="{{ product.price | money_without_currency | strip_html }}">
  <meta property="og:price:currency" content="{{ cart.currency.iso_code }}">
{%- endif -%}

{%- if settings.social_twitter_link != blank -%}
  {%- assign twitter_handle = settings.social_twitter_link | split: 'twitter.com/' | last | split: 'x.com/' | last | split: '?' | first | remove: '/' | prepend: '@' -%}
  <meta name="twitter:site" content="{{ twitter_handle | escape }}">
{%- endif -%}

<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ meta_title | escape }}">
<meta name="twitter:description" content="{{ meta_description | escape }}">
{%- if og_image_https != blank -%}
  <meta name="twitter:image" content="{{ og_image_https }}">
{%- endif -%}
