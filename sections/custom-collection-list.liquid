{%- if section.blocks.size > 0 -%}
<style>
  #shopify-section-{{ section.id }} {
    padding-block-start: calc(var(--section-spacing-unit-size) * {{ section.settings.spacing_top }});
    padding-block-end: calc(var(--section-spacing-unit-size) * {{ section.settings.spacing_bottom }});
  }
  .custom-collection-list__grid {
    display: grid;
    gap: 1.5rem;
    grid-auto-flow: column;
    grid-auto-columns: calc(100% / {{ section.settings.columns_mobile }} - 0.75rem);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline-start: 1rem;
    padding-block-end: 1rem;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }
  .custom-collection-list__grid::-webkit-scrollbar {
    display: none;
  }
  @media screen and (min-width: 750px) {
    .custom-collection-list__grid {
      {% if section.settings.columns_desktop > 5 %}
      grid-auto-flow: column;
      grid-auto-columns: calc(100% / 5.5 - 1.5rem); /* show 5.5 items to indicate scrolling */
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      {% else %}
      grid-auto-flow: row;
      grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr);
      overflow-x: visible;
      {% endif %}
      padding-block-end: 0;
      gap: 2rem;
    }
  }
  .custom-collection-card {
    scroll-snap-align: start;
    position: relative;
    display: block;
    aspect-ratio: {{ section.settings.image_ratio }};
    border-radius: var(--card-corner-radius);
    overflow: hidden;
    text-decoration: none;
    background-color: rgb(var(--color-background));
  }
  .custom-collection-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }
  .custom-collection-card:hover .custom-collection-card__image {
    transform: scale(1.08);
  }
  .custom-collection-card__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0,0,0,0.85) 0%, rgba(0,0,0,0.4) 30%, transparent 60%);
    pointer-events: none;
    z-index: 1;
    transition: opacity 0.4s ease;
  }
  .custom-collection-card:hover .custom-collection-card__overlay {
    opacity: 0.9;
  }
  .custom-collection-card__title {
    position: absolute;
    inset-block-end: 2rem;
    inset-inline: 0;
    text-align: center;
    color: #ffffff;
    font-family: var(--font-heading-family);
    font-size: 1.8rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    z-index: 2;
    margin: 0;
    padding: 0 1rem;
    text-shadow: 0 2px 4px rgba(0,0,0,0.5);
    transition: transform 0.4s ease;
  }
  .custom-collection-card:hover .custom-collection-card__title {
    transform: translateY(-5px);
  }
  @media screen and (max-width: 749px) {
    .custom-collection-card__title {
      font-size: 1.4rem;
      inset-block-end: 1.5rem;
    }
    .custom-collection-list__grid {
      gap: 1rem;
    }
  }
</style>

<div class="color-{{ section.settings.color_scheme }} gradient js-animation-fade-in">
  <div class="container {{ section.settings.section_width }}">
    {%- if section.settings.title != blank -%}
      <h2 class="h2 section__heading {{ section.settings.heading_alignment }}">{{ section.settings.title | escape }}</h2>
    {%- endif -%}
    
    <div class="custom-collection-list__grid">
      {%- for block in section.blocks -%}
        {%- liquid
          assign collection_detail = block.settings.collection
          assign collection_title = block.settings.title
          assign collection_image = block.settings.image | default: collection_detail.featured_image
        -%}
        <a href="{{ collection_detail.url | default: '#' }}" class="custom-collection-card" {{ block.shopify_attributes }}>
          {%- if collection_image != blank -%}
            {%- render 'image', image: collection_image, class: 'custom-collection-card__image' -%}
          {%- else -%}
            {{ 'collection-1' | placeholder_svg_tag: 'custom-collection-card__image placeholder-svg' }}
          {%- endif -%}
          <div class="custom-collection-card__overlay"></div>
          {%- if collection_title != blank -%}
            <h3 class="custom-collection-card__title">{{ collection_title }}</h3>
          {%- endif -%}
        </a>
      {%- endfor -%}
    </div>
  </div>
</div>
{%- endif -%}

{% schema %}
{
  "name": "Custom Collection Grid",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Shop by Category"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "options": [
        { "value": "1/1", "label": "Square (1:1)" },
        { "value": "4/5", "label": "Portrait (4:5)" },
        { "value": "3/4", "label": "Portrait (3:4)" },
        { "value": "2/3", "label": "Tall Portrait (2:3)" }
      ],
      "default": "2/3"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 5,
      "label": "Number of columns on desktop"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Number of columns on mobile",
      "options": [
        { "value": "1", "label": "1 column" },
        { "value": "2", "label": "2 columns" }
      ],
      "default": "2"
    },
    {
      "type": "header",
      "content": "Global Settings"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "max-w-page", "label": "Page width" },
        { "value": "max-w-fluid", "label": "Full width" }
      ],
      "default": "max-w-fluid"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "select",
      "id": "spacing_top",
      "label": "Top spacing",
      "options": [
        { "value": "0", "label": "None" },
        { "value": "1", "label": "Small" },
        { "value": "2", "label": "Medium" },
        { "value": "4", "label": "Large" },
        { "value": "6", "label": "Extra large" }
      ],
      "default": "2"
    },
    {
      "type": "select",
      "id": "spacing_bottom",
      "label": "Bottom spacing",
      "options": [
        { "value": "0", "label": "None" },
        { "value": "1", "label": "Small" },
        { "value": "2", "label": "Medium" },
        { "value": "4", "label": "Large" },
        { "value": "6", "label": "Extra large" }
      ],
      "default": "2"
    }
  ],
  "max_blocks": 20,
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom Image",
          "info": "Overrides the default collection image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Custom Title",
          "info": "Overrides the default collection title"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Collection Grid",
      "blocks": [
        { "type": "collection" },
        { "type": "collection" },
        { "type": "collection" },
        { "type": "collection" },
        { "type": "collection" }
      ]
    }
  ]
}
{% endschema %}
